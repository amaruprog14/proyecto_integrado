SECRET_KEY=
DEBUG='True'
ALLOWED_HOSTS='localhost,127.0.0.1'

# Swagger y ReDoc se habilitan con DEBUG o con esta opción.
SGR_API_DOCS_ENABLED=False
# Opcional. Si está vacía, Simple JWT firma con SECRET_KEY.
SGR_API_JWT_SIGNING_KEY=
DB_ENGINE="django.db.backends.mysql"
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST="localhost"
DB_PORT="3306"

# Clave para las cuentas de la semilla de evaluación.
SEED_DEMO_PASSWORD=

# Días corridos sin registros válidos para destacar la inactividad. 0 desactiva el aviso.
PERFORMANCE_INACTIVITY_DAYS=0
COMMITMENT_DUE_WARNING_DAYS=3

# Correo (por defecto se imprime en la consola de runserver)
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
DEFAULT_FROM_EMAIL="SGR La Serena <no-reply@example.test>"
EMAIL_HOST=
EMAIL_PORT="587"
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS="True"
PORTAL_INVITATION_TIMEOUT_HOURS="24"

# Bloqueo temporal de inicio de sesión
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="10"

# Recuperación de contraseña por enlace (vigencia en segundos: 3600 = 1 hora)
PASSWORD_RESET_TIMEOUT="3600"
PASSWORD_RESET_RESEND_WAIT_SECONDS="45"
PASSWORD_RESET_MIN_RESPONSE_SECONDS="1"

CLAMAV_ENABLED=false
CLAMAV_CLIENT=clamdscan
